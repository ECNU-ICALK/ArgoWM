{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cot-maize.local/v2/metric-evidence.schema.json",
  "title": "Maize sv1 paired metric evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "metric_key",
    "source",
    "target",
    "unit",
    "algorithm_version",
    "qc"
  ],
  "properties": {
    "metric_key": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "$ref": "#/$defs/observation"
    },
    "target": {
      "$ref": "#/$defs/observation"
    },
    "unit": {
      "type": "string",
      "minLength": 1
    },
    "algorithm_version": {
      "type": "string",
      "minLength": 1
    },
    "qc": {
      "$ref": "#/$defs/qc"
    }
  },
  "$defs": {
    "status": {
      "type": "string",
      "enum": [
        "available",
        "provisional",
        "pending",
        "invalid",
        "not_applicable"
      ]
    },
    "number_or_null": {
      "type": [
        "number",
        "null"
      ]
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "value",
        "status",
        "image_sha256",
        "mask_sha256"
      ],
      "properties": {
        "value": {
          "$ref": "#/$defs/number_or_null"
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "image_sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "mask_sha256": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "qc": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "valid",
        "reason_codes"
      ],
      "properties": {
        "valid": {
          "type": "boolean"
        },
        "reason_codes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "color_coverage": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "boundary_contact": {
          "type": "boolean"
        },
        "bottom_gap": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 100
        }
      }
    }
  }
}
