{
  "version": "wgsr_maize_planner_training_v1",
  "experiment_role": "proposed_method_planner",
  "active_planner_variant": "proposed_cot",
  "cot_version": "v3",
  "numeric_evidence_format": "maize_sv1_v1",
  "time_condition_unit": "days",
  "planner_protocol_version": "wgsr_maize_planner_direct_days_v1",
  "output_wrapper": "GROWTH_COT",
  "simple_baseline_uses_planner": false,
  "framework": "ms-swift",
  "framework_version": "4.6.0",
  "template": "qwen3_8",
  "model_path": "${planner_model}",
  "data_root": "${data_root}/maize/planner",
  "protocol_root": "protocols/maize_four_way_v1",
  "environment_prefix": "${planner_env}",
  "swift_executable": "${planner_env}/bin/swift",
  "seed": 42,
  "data_seed": 42,
  "train_type": "lora",
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "target_modules": "all-linear",
  "freeze_vision_tower": true,
  "freeze_aligner": true,
  "deepspeed": "zero3",
  "torch_dtype": "bfloat16",
  "num_train_epochs": 2,
  "per_device_train_batch_size": 2,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 1,
  "world_size": 8,
  "effective_global_batch_size": 16,
  "learning_rate": 0.0001,
  "lr_scheduler_type": "cosine_with_min_lr",
  "lr_scheduler_min_lr": 1e-06,
  "warmup_ratio": 0.03,
  "weight_decay": 0.0,
  "max_length": 4096,
  "max_pixels": 983040,
  "eval_strategy": "no",
  "save_strategy": "steps",
  "save_steps": 400,
  "save_total_limit": 1,
  "logging_steps": 10,
  "check_model": false,
  "planner": {
    "dataset_dir": "${data_root}/maize/planner",
    "enable_thinking": false,
    "output_dir": "${run_root}/maize/planner/checkpoints"
  },
  "species": "maize",
  "cuda_visible_devices": "${maize_planner_gpus}",
  "grouped_loss": {
    "version": "wgsr_maize_planner_grouped_loss_v1",
    "weights": {
      "stage": 0.1,
      "metric": 0.4,
      "text": 0.5
    },
    "normalization": "tokens within field; current/future equally; four metric fields equally; examples equally",
    "metric_scope": "Source/Target/Change suffix or registered culm stable suppression; tassel and ear remain qualitative text"
  }
}
