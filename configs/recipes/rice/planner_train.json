{
  "version": "wgsr_v9_planner_training_cot_v3_grouped_loss_rank32_alpha64_v1",
  "experiment_role": "proposed_method_planner",
  "active_planner_variant": "proposed_cot",
  "cot_version": "v3",
  "numeric_evidence_format": "metric_named_v1",
  "time_condition_unit": "weeks",
  "planner_protocol_version": "wgsr_v9_planner_v3_direct_metric_named_weeks_v1",
  "output_wrapper": "GROWTH_COT",
  "simple_baseline_uses_planner": false,
  "framework": "ms-swift",
  "framework_version": "4.6.0",
  "template": "qwen3_8",
  "model_path": "${planner_model}",
  "data_root": "${data_root}/rice/planner",
  "protocol_root": "protocols/planner_v3_direct_metric_named_weeks",
  "environment_prefix": "${planner_env}",
  "swift_executable": "${planner_env}/bin/swift",
  "seed": 42,
  "data_seed": 42,
  "train_type": "lora",
  "lora_rank": 32,
  "lora_alpha": 64,
  "lora_dropout": 0.05,
  "target_modules": "all-linear",
  "freeze_vision_tower": true,
  "freeze_aligner": true,
  "fsdp": "${repo_root}/configs/fsdp2_planner_full_state.json",
  "torch_dtype": "bfloat16",
  "num_train_epochs": 2,
  "per_device_train_batch_size": 8,
  "per_device_eval_batch_size": 1,
  "gradient_accumulation_steps": 1,
  "world_size": 2,
  "effective_global_batch_size": 16,
  "cuda_visible_devices": "${rice_planner_gpus}",
  "learning_rate": 0.0001,
  "lr_scheduler_type": "cosine_with_min_lr",
  "lr_scheduler_min_lr": 1e-06,
  "warmup_ratio": 0.03,
  "weight_decay": 0.0,
  "max_length": 4096,
  "max_pixels": 602112,
  "eval_strategy": "no",
  "save_strategy": "steps",
  "save_steps": 1000,
  "save_total_limit": 1,
  "logging_steps": 10,
  "check_model": false,
  "planner": {
    "dataset_dir": "${data_root}/rice/planner",
    "enable_thinking": false,
    "output_dir": "${run_root}/rice/planner/checkpoints"
  },
  "grouped_loss": {
    "version": "wgsr_planner_grouped_loss_v1",
    "weights": {
      "stage": 0.1,
      "metric": 0.4,
      "text": 0.5
    },
    "normalization": "tokens within field; current/future equally; metric fields equally; examples equally",
    "stage_scope": "complete current/future stage values including terminal period",
    "metric_scope": "complete Metric/Source/Target/Change suffix in Growth plan",
    "text_scope": "all other supervised answer tokens including assistant EOS; excludes prompt, image, empty think and padding"
  }
}
